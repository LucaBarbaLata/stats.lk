# Copy to .env and fill in. Never commit .env.

# Where the app is reachable. Spotify only accepts https URLs, except loopback:
# use http://127.0.0.1:3000 locally (not "localhost"), https://stats.lucariki.top in production.
APP_URL=http://127.0.0.1:3000

# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later logs everyone out of Spotify (stored tokens become unreadable).
TOKEN_ENCRYPTION_KEY=

# Local development database (docker-compose.dev.yml).
# In production docker-compose.yml builds DATABASE_URL from POSTGRES_PASSWORD instead.
# It goes into that URL, so use letters and digits only: openssl rand -hex 24
DATABASE_URL=postgres://statslk:statslk@127.0.0.1:5432/statslk
POSTGRES_PASSWORD=

# Production only: the local port the server's web server forwards to.
# WEB_PORT=3000

# How often each user's recently played tracks are fetched in the background
SYNC_INTERVAL_MINUTES=3

# Artist genres (Spotify no longer returns them). Free key: https://www.last.fm/api/account/create
# Leave empty to skip genres.
LASTFM_API_KEY=

# Shown on /privacy and /terms as the contact address (optional)
CONTACT_EMAIL=

# Comma-separated Spotify user IDs that can open /admin.
# Your ID is the Username on https://www.spotify.com/account/profile/
ADMIN_SPOTIFY_IDS=
